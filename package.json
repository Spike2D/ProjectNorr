{
  "name": "project-norr",
  "version": "1.0.0",
  "description": "Project Norr - EQ Legends Combat Parser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:parser": "node src/parser.test.js",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.projectnorr.app",
    "productName": "Project Norr",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  }
}
